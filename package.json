{
  "name": "@rljson/hash",
  "version": "0.0.18",
  "description": "Deeply apply hashes to JSON data",
  "homepage": "https://github.com/rljson/hash",
  "bugs": "https://github.com/rljson/hash/issues",
  "access": "public",
  "license": "MIT",
  "engines": {
    "node": ">=22.14.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rljson/hash.git"
  },
  "main": "dist/hash.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "npx vite build && tsc && cp README* dist && mkdir dist/src && cp src/example.ts dist/src",
    "test": "npx vitest run --coverage && npm run lint",
    "prebuild": "npm run test",
    "prepublishOnly": "npm run build",
    "lint": "npx eslint",
    "updateGoldens": "cross-env UPDATE_GOLDENS=true npm test"
  },
  "devDependencies": {
    "@tssuite/golden": "^0.0.3",
    "@types/node": "^25.0.9",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "@vitest/coverage-v8": "^4.0.17",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.2",
    "eslint-plugin-jsdoc": "^62.0.0",
    "eslint-plugin-tsdoc": "^0.5.0",
    "globals": "^17.0.0",
    "read-pkg": "^10.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.53.0",
    "vite": "^7.3.1",
    "vite-node": "^5.2.0",
    "vite-plugin-dts": "^4.5.4",
    "vite-tsconfig-paths": "^6.0.4",
    "vitest": "^4.0.17",
    "vitest-dom": "^0.1.1"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@rljson/json": "^0.0.23",
    "js-base64": "^3.7.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.19.0"
}
